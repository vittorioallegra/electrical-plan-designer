{
  "name": "electrical-plan-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && pnpm --filter @epd/web exec playwright install chromium",
    "dev": "pnpm --filter @epd/web dev",
    "desktop:dev": "pnpm --filter @epd/desktop dev",
    "desktop:build": "pnpm typecheck && pnpm --filter @epd/desktop build:app",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p . && node node_modules/typescript7/bin/tsc --noEmit -p apps/web && node node_modules/typescript7/bin/tsc --noEmit -p packages/domain && node node_modules/typescript7/bin/tsc --noEmit -p packages/bridge && node node_modules/typescript7/bin/tsc --noEmit -p apps/desktop",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @epd/web test:e2e",
    "test:e2e:desktop": "pnpm --filter @epd/desktop build && pnpm --filter @epd/desktop test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm test:e2e:desktop",
    "demo:epd": "node scripts/build-demo-epd.mjs"
  },
  "devDependencies": {
    "@epd/domain": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
