{
  "name": "electrical-plan-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && pnpm db:start && pnpm env:local && pnpm db:reset && pnpm exec playwright install chromium",
    "dev": "node scripts/check-env.mjs && vite",
    "dev:mem": "vite --mode memory",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/check-env.mjs && vitest run --config vitest.db.config.ts",
    "test:e2e": "node scripts/check-env.mjs && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm test:e2e",
    "env:local": "node scripts/env-local.mjs",
    "db:seed": "node scripts/build-seed.mjs",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts && prettier --write src/data/database.types.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "i18next": "^26.5.10",
    "immer": "^11.2.9",
    "jspdf": "^4.2.1",
    "konva": "^10.9.0",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.8",
    "react-konva": "^19.3.2",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
