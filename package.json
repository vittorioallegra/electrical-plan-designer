{
  "name": "electrical-plan-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install && pnpm db:start && pnpm env:local && pnpm db:reset && pnpm --filter @epd/web exec playwright install chromium",
    "dev": "node scripts/check-env.mjs && pnpm --filter @epd/web dev",
    "dev:mem": "pnpm --filter @epd/web dev:mem",
    "build": "pnpm typecheck && pnpm --filter @epd/web build",
    "preview": "pnpm --filter @epd/web preview",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit -p . && node node_modules/typescript7/bin/tsc --noEmit -p apps/web && node node_modules/typescript7/bin/tsc --noEmit -p packages/domain",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/check-env.mjs && pnpm --filter @epd/web test:db",
    "test:e2e": "node scripts/check-env.mjs && pnpm --filter @epd/web test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm test:e2e",
    "env:local": "node scripts/env-local.mjs",
    "db:seed": "node scripts/build-seed.mjs",
    "db:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/repositories/database.types.ts && prettier --write apps/web/src/lib/repositories/database.types.ts"
  },
  "devDependencies": {
    "@epd/domain": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
